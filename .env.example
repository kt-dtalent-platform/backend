DB_USERNAME=kt_app
DB_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password
DB_PORT=3306

# JWT 서명 키: openssl rand -base64 32 결과를 넣으세요
JWT_SECRET=
# access token 만료 시간(기본 2h)
JWT_ACCESS_TOKEN_EXPIRATION=2h
# S3 연결을 준비한 환경에서만 활성화. 자격 증명은 AWS SDK 기본 체인으로 제공합니다.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
