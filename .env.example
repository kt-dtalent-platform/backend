# 개발 DB 접속
DB_USERNAME=kt_app
DB_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password
DB_PORT=3306

# 초기 담당자 계정
# 비밀번호 12자 이상 및 UTF-8 72바이트 이하
