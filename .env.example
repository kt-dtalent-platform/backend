DB_USERNAME=kt_app
DB_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password
DB_PORT=3306

# JWT 서명 키: openssl rand -base64 32 결과를 넣으세요
JWT_SECRET=
# access token 만료 시간(기본 2h)
JWT_ACCESS_TOKEN_EXPIRATION=2h
# S3 연결을 준비한 환경에서만 활성화. 자격 증명은 AWS SDK 기본 체인으로 제공합니다.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=

# 로그인 안내 발송: SMTP 연결 후에만 활성화. 발신 주소·이름은 담당자 설정 API에서 관리
LOGIN_MAIL_ENABLED=false
LOGIN_MAIL_LOGIN_URL=https://kt-dtalent-platform.github.io/login
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# 업스테이지 OCR API 키 (성적증명서 문서 분석). 비워 두면 OCR 꺼짐
UPSTAGE_API_KEY=
