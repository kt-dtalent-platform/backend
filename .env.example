DB_USERNAME=kt_app
DB_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password
DB_PORT=3306

# JWT 서명 키: openssl rand -base64 32 결과를 넣으세요
JWT_SECRET=
# access token 만료 시간(기본 30m), refresh token 만료 시간(기본 14d)
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
# S3 연결을 준비한 환경에서만 활성화. 자격 증명은 AWS SDK 기본 체인으로 제공합니다.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=

# 업스테이지 OCR API 키 (성적증명서 문서 분석). 비워 두면 OCR 꺼짐
UPSTAGE_API_KEY=
