# 개발 서버 전용 설정. 서버에서 .env로 복사한 뒤 값을 채우세요
# 비밀번호와 JWT_SECRET은 서버에서 openssl rand -base64 32 로 새로 만드세요
DB_USERNAME=kt_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT 서명 키(Base64, 32바이트 이상)
JWT_SECRET=
# access token 만료 시간
JWT_ACCESS_TOKEN_EXPIRATION=2h

# 파일 저장소(S3). AWS 키는 넣지 않습니다 (EC2 역할로 자동 인증)
# 버킷 이름(팀 내부 공유 값)을 넣은 뒤 S3_ENABLED를 true로 바꾸세요
S3_ENABLED=false
S3_BUCKET=
S3_REGION=ap-northeast-2

# 업스테이지 OCR API 키 (성적증명서 문서 분석). 비워 두면 OCR 꺼짐
UPSTAGE_API_KEY=
